# ════════════════════════════════════════════════════════════
#  LAND REGISTRY — ROOT ENVIRONMENT EXAMPLE
#  Copy this file to .env and fill in your values.
#  Never commit the actual .env file to version control.
# ════════════════════════════════════════════════════════════

# ─── General ─────────────────────────────────────────────────
NODE_ENV=development

# ─── Backend ─────────────────────────────────────────────────
BACKEND_PORT=5000
BACKEND_HOST=localhost

# ─── Frontend ────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ─── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/land_registry
MONGODB_DB_NAME=land_registry

# ─── JWT Authentication ───────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Blockchain / Ethereum ────────────────────────────────────
BLOCKCHAIN_NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOYER_PRIVATE_KEY=replace_with_deployer_private_key

# ─── Etherscan (for contract verification) ───────────────────
ETHERSCAN_API_KEY=replace_with_etherscan_api_key

# ─── IPFS (for document storage) ─────────────────────────────
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ─── Email (for notifications) ───────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
EMAIL_FROM=noreply@landregistry.local
